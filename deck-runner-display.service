[Unit]
Description=Deck Runner desktop display
PartOf=graphical-session.target
After=graphical-session.target deck-runner.service
Wants=deck-runner.service

[Service]
ExecCondition=/usr/bin/flatpak info com.google.Chrome
ExecStart=/usr/bin/python3 %h/.local/share/deck-runner/app/display.py
ExecStop=/usr/bin/python3 %h/.local/share/deck-runner/app/display.py stop
Restart=on-failure
RestartSec=5
